# =============================================================================
# Imperial Press — global secrets & application config (repo root only)
# Copy to `.env` and fill in real values. Never commit `.env`.
# Host publish ports live in `.env.compose` (see `.env.compose.example`).
# Do not add per-app .env files under backend/, frontend-web/, or frontend-admin/.
# =============================================================================

# --- Single public domain (no subdomains) ---
# Local hybrid: localhost. Production: your real hostname (e.g. imperialpress.com).
DOMAIN=localhost
CERTBOT_EMAIL=admin@imperialpress.com

# Path prefix for the admin SPA. Public site is always at "/".
# Production URL: https://$DOMAIN$ADMIN_BASE_PATH/
ADMIN_BASE_PATH=/admin

# --- Local hybrid ports (apps on host; Docker infra host ports in .env.compose) ---
WEB_PORT=50173
ADMIN_PORT=50174
API_PORT=8000
# Hostname for reaching Docker-published infra ports from apps on the host
INFRA_HOST=localhost

# --- Database ---
POSTGRES_USER=imperial
POSTGRES_DB=imperial_press
DB_PASSWORD=change_me_strong_password
# DATABASE_URL / TEST_DATABASE_URL / MEILISEARCH_URL / GARAGE_ENDPOINT are built
# automatically from INFRA_HOST + HOST_* ports in .env.compose. Set them only to
# override (e.g. production Compose injects DATABASE_URL for the api container).

# --- FastAPI / JWT ---
SECRET_KEY=change_me_64_char_random_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ENABLE_SWAGGER=true
# Comma-separated browser origins allowed by CORS (not always localhost — set explicitly).
# Local hybrid: web + admin dev servers. Production: usually https://$DOMAIN only.
ALLOWED_ORIGINS=http://localhost:50173,http://localhost:50174

# --- Default admin (seeded on API startup if email not yet registered) ---
# See docs/default-admin-credentials.md — change before any production deploy.
DEFAULT_ADMIN_EMAIL=admin@imperialpress.com
DEFAULT_ADMIN_PASSWORD=ImperialAdmin2026!
DEFAULT_ADMIN_FULL_NAME=Imperial Press Admin

# --- MeiliSearch ---
MEILISEARCH_MASTER_KEY=change_me_master_key
MEILISEARCH_SEARCH_KEY=change_me_search_only_key

# --- Next.js (build-time public + server) ---
# NEXT_PUBLIC_API_BASE_URL / NEXT_PUBLIC_MEILISEARCH_HOST / VITE_API_BASE_URL are built
# from API_PORT + HOST_MEILI_PORT (.env.compose) unless overridden for production.
NEXT_REVALIDATE_SECRET=change_me_revalidate_secret

# --- Garage object storage ---
# Prefer editing infra/garage/garage.toml rpc_secret for the cluster secret.
# S3 credentials are created at first setup (see docs/architecture/storage.md).
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_REGION=garage
# Public URL Nginx uses for /assets/ (prod: https://$DOMAIN/assets)
GARAGE_PUBLIC_ASSETS_ENDPOINT=http://localhost/assets

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@imperialpress.com

# =============================================================================
# Production overrides (set these when deploying — replace localhost defaults)
# =============================================================================
# DOMAIN=imperialpress.com
# CERTBOT_EMAIL=admin@imperialpress.com
# ALLOWED_ORIGINS=https://imperialpress.com
# Or rely on auto-build from DOMAIN + HOST_API_PORT / HOST_MEILI_PORT in .env.compose
# GARAGE_PUBLIC_ASSETS_ENDPOINT=https://imperialpress.com/assets
# ENABLE_SWAGGER=false
