# =============================================================================
# Imperial Press — Docker ports (repo root only; loaded with `.env` by compose.*)
# Copy to `.env.compose` and adjust.
#
# CONTAINER_* — ports services listen on inside the Docker network.
# HOST_*      — ports published on the host (local hybrid or production).
#
# Local hybrid (`compose.sh infra`): HOST_POSTGRES / MEILI / GARAGE_* matter.
# Production (`compose.sh prod`): HOST_HTTP / HTTPS / API matter.
# CONTAINER_GARAGE_* must match infra/garage/garage.toml if you change them.
# =============================================================================

# --- Container-internal ports (Docker network) ---
CONTAINER_WEB_PORT=3000
CONTAINER_ADMIN_PORT=3001
CONTAINER_API_PORT=8000
CONTAINER_POSTGRES_PORT=5432
CONTAINER_MEILI_PORT=7700
CONTAINER_NGINX_HTTP_PORT=80
CONTAINER_NGINX_HTTPS_PORT=443
CONTAINER_GARAGE_S3_PORT=3900
CONTAINER_GARAGE_WEB_PORT=3902
CONTAINER_GARAGE_ADMIN_PORT=3903

# --- Host publish ports ---
# Nginx (production full stack) — public site at / and admin at /admin
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

# API on its own host port (not path-proxied on the site domain)
HOST_API_PORT=8000

# App host ports (reserved — apps run on host in local hybrid, not via Compose)
HOST_WEB_PORT=50173
HOST_ADMIN_PORT=50174

# Backing services — published for local hybrid development
# 5433 avoids clashing with a local system Postgres on 5432
HOST_POSTGRES_PORT=5433
HOST_MEILI_PORT=7700
HOST_GARAGE_S3_PORT=3900
HOST_GARAGE_ADMIN_PORT=3903
