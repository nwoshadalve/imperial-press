# =============================================================================
# Imperial Press — Docker host publish ports
# Copy to `.env.compose` and adjust.
#
# Local hybrid (`compose.sh infra`): only HOST_POSTGRES / MEILI / GARAGE_* matter.
# Production (`compose.sh prod`): HOST_HTTP_PORT / HOST_HTTPS_PORT / HOST_API_PORT matter.
# Container-internal ports stay fixed (3000/3001/8000/5432/7700/3900…).
# =============================================================================

# Nginx (production full stack) — serves public site at / and admin at /admin
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

# API published on its own host port (not path-proxied on the site domain)
HOST_API_PORT=8000

# App host ports (unused in current local/prod workflows; reserved)
HOST_WEB_PORT=50173
HOST_ADMIN_PORT=50174

# Backing services — published for local hybrid development
# 5433 avoids clashing with a local system Postgres on 5432
HOST_POSTGRES_PORT=5433
HOST_MEILI_PORT=7700
HOST_GARAGE_S3_PORT=3900
HOST_GARAGE_ADMIN_PORT=3903
